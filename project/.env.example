# VLM API Configuration (Hack Club AI Proxy)
VLM_PROVIDER=qwen
VLM_API_KEY=do-not-put-a-secret-here

# Server Configuration
PORT=5670
NODE_ENV=development

# Database
DATABASE_PATH=./data/question_database.json
BACKUP_DIR=./data/backups

# Processing Configuration
OUTPUT_DIRECTORY=./output
CACHE_DIRECTORY=./cache
MAX_CONCURRENT_PAGES=5
IMAGE_RESOLUTION=300

# Storage (optional - for file uploads)
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=50

# CORS (for app connection)
ALLOWED_ORIGINS=http://localhost:8081,exp://192.168.*

# React Native App Backend URL (Production)
EXPO_PUBLIC_API_URL=https://astra-backend.eryzalabs.cloud/api
EXPO_PUBLIC_SERVER_URL=https://astra-backend.eryzalabs.cloud

# Logging
LOG_LEVEL=info
ENABLE_DEBUG=false

# Cashfree Payment Gateway Configuration
# Set EXPO_PUBLIC_CASHFREE_ENV to 'sandbox' or 'production'
EXPO_PUBLIC_CASHFREE_ENV=sandbox

# Production App ID
EXPO_PUBLIC_CASHFREE_PROD_APP_ID=your_cashfree_prod_app_id

# Sandbox Test App ID
EXPO_PUBLIC_CASHFREE_TEST_APP_ID=your_cashfree_test_app_id
